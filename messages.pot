#
# File: module/Application/view/application/destinations/peru.phtml, line: 241
msgid "Nightlife"
msgstr ""
#
# File: module/Application/view/application/destinations/peru.phtml, line: 242
msgid "Experience the vibrant nightlife of Peru, from Lima's trendy bars to Cusco's lively clubs."
msgstr ""
